# Required for Hugging Face hosted inference only. Use a fine-grained token with
# "Make calls to Inference Providers" permission. Never commit the token.
HF_TOKEN=

# Change the model after evaluating it against this project's test set.
HF_MODEL=Qwen/Qwen3-32B
HF_MAX_RETRIES=2
HF_RETRY_BUDGET_SECONDS=8
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_SECONDS=45
LLM_MAX_TURNS=8
LLM_MAX_OUTPUT_TOKENS=1200

# Operational configuration
LOG_LEVEL=INFO
SERVICE_NAME=supply-chain-exception-poc
POLICY_VERSION=2026-09-11.v1
TRACE_BUFFER_SIZE=2000
AUDIT_BUFFER_SIZE=1000
