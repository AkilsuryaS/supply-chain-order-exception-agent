# Required only for POST /agent/llm-triage
OPENAI_API_KEY=

# Change the model after evaluating it against this project's test set.
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=30
LLM_MAX_TURNS=8
LLM_MAX_OUTPUT_TOKENS=1200

# Operational configuration
LOG_LEVEL=INFO
SERVICE_NAME=supply-chain-exception-poc
POLICY_VERSION=2026-09-11.v1
TRACE_BUFFER_SIZE=2000
AUDIT_BUFFER_SIZE=1000
